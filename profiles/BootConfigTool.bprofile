# BootConfigTool #
  ProfileName="BootConfigTool"

# Download URL #
  BootConfigTool_Download_URL="https://github.com/tcsresearch/BootConfigTool/archive/refs/heads/main.zip"

# Install Dirs #
  BootConfigTool_install_Dir_Root="/etc/BootConfigTool"
  BootConfigTool_install_Dir_NonRoot="~/TCS_IT/BootConfigTool"

# Dynamic Installer #
  BootConfigTool_install_Dir_Selected="$InstallDir_Base_Selected/$ProfileName"
