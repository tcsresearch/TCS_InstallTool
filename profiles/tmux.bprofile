# tmux #
ProfileName="tmux"

# Download URL #
  tmux_Download_URL="https://github.com/tcsresearch/tmux-configs/archive/refs/heads/main.zip"
  
# Install Dirs #
  tmux_install_Dir_Root="/etc"
  tmux_install_Dir_NonRoot="$(pwd)/.tmux"
  tmux_install_Dir_Selected="$InstallDir_Base_Selected/$ProfileName"

#---------------------------------------------------------------------------------------------------------------------------#

# tmux-custom-plugins #
ProfileName="tmux-custom-plugins"

# Download URL #
  tmux_plugins_Download_URL="https://github.com/tcsresearch/tmux-custom-plugins/archive/refs/heads/main.zip"
  
# Install Dirs #
  tmux-custom-plugins_install_Dir_Root="/etc/tmux/tpm"
  tmux-custom-plugins_install_Dir_NonRoot="~/.tmux/tpm # Should we use '$(pwd)/.tmux/tpm' ?
  tmux-custom-plugins-install_Dir_Selected="$InstallDir_Base_Selected/$ProfileName"
