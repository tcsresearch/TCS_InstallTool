# GitChecker #
  ProfileName="GitChecker"

# Download URL #
  GitChecker_Download_URL="https://github.com/tcsresearch/GitChecker/archive/refs/heads/main.zip"

# Install Dirs #
  GitChecker_install_Dir_Root="/etc/GitChecker"
  GitChecker_install_Dir_NonRoot="~/TCS_IT/GitChecker"

# Dynamic Installer #
  GitChecker_install_Dir_Selected="$InstallDir_Base_Selected/$ProfileName"
