# Install Dirs #
  BLING_install_Dir_Root="etc/GitChecker"
  BLING_install_Dir_NonRoot="~/TCS_IT/GitChecker"

# Dynamic Installer #
  BLING_install_Dir_Selected="$InstallDir_Base_Selected/$ProfileName
