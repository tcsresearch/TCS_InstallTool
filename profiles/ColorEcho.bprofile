# ColorEcho #
ProfileName="ColorEcho"

# Download URL #
  ColorEcho_Download_URL="https://github.com/tcsresearch/ColorEcho/archive/refs/heads/main.zip"

# Install Dirs #
  ColorEcho_install_Dir_Root="/etc/ColorEcho"
  ColorEcho_install_Dir_NonRoot="~/ColorEcho"

# Dynamic Installer #
  ColorEcho_install_Dir_Selected="$InstallDir_Base_Selected/$ProfileName"
