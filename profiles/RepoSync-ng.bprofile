# RepoSync-ng #
  ProfileName="RepoSync-ng"

# Download URL #
  RepoSync-ng_Download_URL="https://github.com/tcsresearch/RepoSync-ng/archive/refs/heads/main.zip"

# Install Dirs #
  RepoSync-ng_install_Dir_Root="/etc/RepoSync-ng"
